# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Atlas connection used by server.ts to save lead and score submissions.
# Configure these variables in the live deployment's environment/secrets.
# Never put real credentials in this file.
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/saas_crush?retryWrites=true&w=majority
MONGODB_DB_NAME=saas_crush
MONGODB_COLLECTION_NAME=expo_leads
MONGODB_OTP_COLLECTION_NAME=otp_challenges
# Optional: comma-separated DNS servers if the system resolver blocks MongoDB SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# WhatsApp Cloud API OTP delivery.
# Set WHATSAPP_OTP_MODE=development for local UI testing, or meta for live delivery.
WHATSAPP_OTP_MODE=development
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_OTP_TEMPLATE_NAME=your_approved_template_name
WHATSAPP_OTP_LANGUAGE_CODE=en
